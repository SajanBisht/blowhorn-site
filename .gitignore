# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# IDEs
.vscode/*

# Hugo build output and caches, and local tools
/public/
/resources/
.hugo_build.lock
.bin/
node_modules/
__pycache__/

# Never commit disk images; publish them as GitHub Release assets
*.dmg
/public-internal/
# The internal section is fetched from leecalcote/blowhorn at build time
# (make build-internal); only the placeholder _index.md is committed.
/content/en/internal/*
!/content/en/internal/_index.md
