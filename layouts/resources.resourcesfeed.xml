{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Blowhorn Resources</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description }}</description>
    <language>en</language>
    <atom:link href="{{ with .OutputFormats.Get "resourcesfeed" }}{{ .Permalink }}{{ end }}" rel="self" type="application/rss+xml"/>
    {{- $pages := where .Site.RegularPages "Section" "eq" "resources" }}
    {{- $pages = where $pages "Type" "ne" "tagfeed" }}
    {{- range $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Params.summary | default .Description }}</description>
      {{- range .Params.tags }}
      <category>{{ . }}</category>
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
