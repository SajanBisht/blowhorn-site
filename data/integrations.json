    {
      "id": "category",
      "label": "By type",
      "kind": "category",
      "note": "Group by how Blowhorn reaches the network."
    },
    {
      "id": "role",
      "label": "By role",
      "kind": "role",
      "note": "Pick a role to highlight the networks it actually uses."
    },
    {
      "id": "constellation",
      "label": "The map",
      "kind": "constellation",
      "note": "Orbiting marks around a live count, to show breadth and room to grow."
    }
  ],
  "categories": [
    {
      "id": "chrome",
      "name": "Your Chrome",
