{
  "$schema": "../schemas/integrations.schema.json",
  "headline": "One queue. Every network that matters.",
  "lede": "One queue for every network your audience reads. LinkedIn, X, Reddit and Hacker News go through your own Chrome with the Blowhorn extension. Slack and Bluesky use their APIs. On GitHub, Blowhorn rallies reactions on the issue, it does not post.",
  "catalogPath": "/integrations/",
  "defaultTreatment": "category",
