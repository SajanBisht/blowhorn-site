{{- /* One /use-cases/<slug>/ page per use case in data/use-cases.json (schema:
  schemas/use-cases.schema.json). The copy lives in the data file;
  layouts/use-case.html renders it through the shared cast-page partial.
  Hugo keeps the hyphen in the data key for use-cases.json. */ -}}
{{- range (index site.Data "use-cases").use_cases }}
  {{- $.AddPage (dict
      "kind" "page"
      "path" .slug
      "title" .name
      "weight" .weight
      "params" (dict "use_case" .slug "description" .description "lastmod" "2026-10-20")
    ) }}
{{- end }}
